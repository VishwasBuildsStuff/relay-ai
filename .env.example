# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Browser API base URL for the React client.
VITE_API_URL="http://localhost:8000"

# Backend configuration examples (set in the shell/environment running FastAPI).
GEMINI_MODEL="gemini-2.5-flash"
# Optional estimates: configure both per-million-token rates and a source/version label.
# Obtain values for the selected model/account from the current provider pricing schedule.
# RELAY_GEMINI_INPUT_USD_PER_MILLION=""
# RELAY_GEMINI_OUTPUT_USD_PER_MILLION=""
# RELAY_GEMINI_PRICING_LABEL="model and pricing schedule revision"
RELAY_DB_PATH="./relay_tasks.sqlite3"
# Optional allow-list of explicit local Git targets; IDs are shown in the dashboard, paths stay server-side.
# RELAY_REPOSITORIES_JSON='{"my-project":"/absolute/path/to/my-project"}'
RELAY_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
RELAY_API_TOKEN=""
# Optional per-user tokens; when configured this takes precedence over RELAY_API_TOKEN.
RELAY_AUTH_USERS_JSON='{}'
# Optional role map. If set, unspecified configured users are read-only viewers.
# RELAY_AUTH_ROLES_JSON='{"alice":"operator","bob":"viewer"}'
RELAY_SANDBOX_IMAGE="relay-ai-sandbox:python3.11"
# Allow-listed server-side test runner: pytest or unittest (no caller command strings).
RELAY_TEST_PROFILE="pytest"
# Trusted local development only. Leave false for untrusted repository uploads.
RELAY_ALLOW_UNSAFE_SUBPROCESS="false"
